// ==============================================================================
// nextflow.config  –  TTA_HBV-OBI Pipeline Configuration
// ==============================================================================

manifest {
    name            = 'TTA_HBV-OBI'
    author          = 'Anh-Genetics'
    description     = 'HBV pre-S1/pre-S2/S Sanger sequencing analysis pipeline for genotype assignment and OBI-associated mutation interpretation'
    version         = '0.1.0-MVP'
    nextflowVersion = '>=23.04'
    homePage        = 'https://github.com/Anh-Genetics/TTA_HBV-OBI'
    mainScript      = 'main.nf'
}

// --------------------------------------------------------------------------- //
// Default parameters (can be overridden on CLI)
// --------------------------------------------------------------------------- //
params {
    // Input / output
    sample_sheet     = null
    outdir           = "results"
    reference_fasta  = "${projectDir}/data/references/hbv_genotype_refs.fasta"
    mutation_db      = "${projectDir}/data/references/obi_mutation_catalogue.tsv"

    // QC
    min_quality      = 20
    min_length       = 200
    trim_ends_bases  = 20

    // Consensus
    min_overlap      = 80
    conflict_policy  = "iupac"

    // Genotype
    blast_evalue     = "1e-10"
    min_genotype_pct = 90.0

    // Report
    report_format    = "html"

    // Resource limits (can be tuned per profile)
    max_memory       = '8.GB'
    max_cpus         = 4
    max_time         = '4.h'
}

// --------------------------------------------------------------------------- //
// Execution profiles
// --------------------------------------------------------------------------- //
profiles {

    // ------------------------------------------------------------------
    // local: for development on a workstation or WSL2
    // ------------------------------------------------------------------
    local {
        process.executor = 'local'

        process {
            withLabel: 'low' {
                cpus   = 1
                memory = '1.GB'
                time   = '30.min'
            }
            withLabel: 'medium' {
                cpus   = 2
                memory = '4.GB'
                time   = '1.h'
            }
            withLabel: 'high' {
                cpus   = 4
                memory = '8.GB'
                time   = '4.h'
            }
        }

        // Use conda environment from environment.yml
        conda.enabled     = true
        conda.useMicromamba = true

        // Nextflow cache within project
        workDir = "${projectDir}/work"
    }

    // ------------------------------------------------------------------
    // test: minimal run with bundled example data
    // ------------------------------------------------------------------
    test {
        includeConfig 'config/profiles/test.config'
    }

    // ------------------------------------------------------------------
    // conda: explicit conda activation (fallback if micromamba absent)
    // ------------------------------------------------------------------
    conda {
        conda.enabled       = true
        conda.useMicromamba = false
    }

    // ------------------------------------------------------------------
    // docker: Docker container profile (stub – image not yet published)
    // ------------------------------------------------------------------
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        process.container   = 'ghcr.io/anh-genetics/tta_hbv-obi:0.1.0-MVP'
    }
}

// --------------------------------------------------------------------------- //
// Process defaults (applied to all processes unless overridden)
// --------------------------------------------------------------------------- //
process {
    // Conda environment for Python-based processes
    conda = "${projectDir}/environment.yml"

    // Default resource label
    label = 'low'

    // Capture stdout/stderr for every process in the work directory
    publishDir = [
        path:    { "${params.outdir}/${task.process.toLowerCase().replaceAll(':', '/')}" },
        mode:    'copy',
        saveAs:  { filename -> filename.endsWith('.log') ? null : filename }
    ]

    errorStrategy = 'finish'
    maxRetries    = 1
}

// --------------------------------------------------------------------------- //
// Nextflow execution settings
// --------------------------------------------------------------------------- //
executor {
    name           = 'local'
    cpus           = params.max_cpus
    memory         = params.max_memory
}

// --------------------------------------------------------------------------- //
// Logging and tracing
// --------------------------------------------------------------------------- //
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// --------------------------------------------------------------------------- //
// Nextflow version check
// --------------------------------------------------------------------------- //
nextflow.enable.dsl = 2
