// config/profiles/test.config
// Minimal test profile using bundled example data
params {
    sample_sheet    = "${projectDir}/data/example/sample_sheet.csv"
    outdir          = "${projectDir}/test_results"
    reference_fasta = "${projectDir}/data/references/hbv_genotype_refs.fasta"
    mutation_db     = "${projectDir}/data/references/obi_mutation_catalogue.tsv"
    min_length      = 50    // relaxed for synthetic test reads
    trim_ends_bases = 5
    report_format   = "tsv"
}

process {
    withLabel: 'low'    { cpus = 1; memory = '512.MB'; time = '10.min' }
    withLabel: 'medium' { cpus = 1; memory = '1.GB';   time = '15.min' }
    withLabel: 'high'   { cpus = 2; memory = '2.GB';   time = '30.min' }
}
